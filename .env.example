# === LLM Provider API Keys ===
# At least ONE provider is required. Groq recommended (free tier, fast).
GROQ_API_KEY=gsk_your_groq_key_here
OPENAI_API_KEY=sk-your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# === Database (Stage 3+) ===
DATABASE_URL=postgresql+asyncpg://router:router123@localhost:5432/ai_router

# === Qdrant (Stage 4+) ===
QDRANT_URL=http://localhost:6333

# === Redis (Stage 7) ===
REDIS_URL=redis://localhost:6379

# === App Settings ===
APP_ENV=development
LOG_LEVEL=info
